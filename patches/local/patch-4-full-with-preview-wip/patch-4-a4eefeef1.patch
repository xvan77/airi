@@ -0,0 +1,22 @@
+/** Stable key for a zip `File` used when persisting Live2D selector thumbnails. */
+export function buildLive2dPreviewSourceKey(file: File): string {
+  return `${file.name}|${file.size}|${file.lastModified}`
+}
+
+export function isLive2dPreviewCurrent(
+  model: {
+    file: File
+    previewImage?: string
+    live2dPreviewVersion?: number
+    live2dPreviewSourceKey?: string
+  },
+  pipelineVersion: number,
+): boolean {
+  if (!model.previewImage)
+    return false
+  if (model.live2dPreviewVersion !== pipelineVersion)
+    return false
+  if (model.live2dPreviewSourceKey !== buildLive2dPreviewSourceKey(model.file))
+    return false
+  return true
+}
